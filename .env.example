# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# MongoDB Atlas connection string
MONGODB_URI=

# Random 32+ byte secret used to sign the admin session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Used only by scripts/create-admin.mjs to create the first admin account.
# Not read anywhere else — safe to change/remove after seeding.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# Cloudinary (added in Phase 2)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
