# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# MongoDB Atlas connection string
MONGODB_URI=

# Random 32+ byte secret used to sign the admin session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Used only by scripts/create-admin.mjs to create the first admin account.
# Not read anywhere else — safe to change/remove after seeding.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# Cloudinary (added in Phase 2)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Paystack — test mode keys (pk_test_.../sk_test_...) are fine to start.
# Secret key stays server-only; it's also used to verify webhook signatures
# (Paystack doesn't use a separate webhook secret).
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Resend — transactional email.
RESEND_API_KEY=
# Must be an address on a domain verified in the Resend dashboard.
RESEND_FROM_EMAIL=
